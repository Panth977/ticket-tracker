{
  "name": "@tm/sdk",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "The typed, zero-dependency JavaScript SDK orchestrators import (docs/plan/agents.html §M).",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -b ../shared && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --project unit",
    "test:emu": "vitest run --passWithNoTests --project emu",
    "test:watch": "vitest",
    "fixtures": "node fixtures/check.mjs",
    "clean": "rm -rf dist .tmp .fixtures *.tsbuildinfo"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tm/backend": "workspace:*",
    "@tm/shared": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
