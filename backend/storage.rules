rules_version = '2';

// TaskManager — Cloud Storage security rules.
//
// Source of truth: app/db.json `attachments` (and its avatar / export notes).
//
// UPLOAD DIRECT, ATTACH THROUGH A COMMAND. The browser uploads straight to
// Storage (with progress); a command then names the object and checks it.
// Ticket attachments now go INTO a memory (memory.html §J — see
// memories/… at the bottom); the old boards/…/tickets/… path is read-only.
// Objects are never overwritten or deleted by a client.
//
// Board roles are read from Firestore with firestore.get() — the same
// boards/{boardId}.access map the Firestore rules use.
//
// READS DO NOT COME THROUGH HERE ANY MORE (phase 11). The app asks the API for
// a file — GET /api/files/url, which checks can(read) on the board and answers
// a short-lived signed URL (or streams the bytes back itself) — because the
// cross-service firestore.get() below CANNOT BE RELIED ON: when that lookup
// fails the rule does not evaluate to false, it ERRORS, and an error is a 403.
// Reproduced against the emulators: an attachment whose board document the
// lookup could not resolve gave "Null value error" at the boardDoc() line →
// storage/unauthorized, while an avatar (rule: plain signedIn(), no
// firestore.get) loaded in the same session — exactly the shape of the
// production failure on agent-uploaded files.
//
// The read rule stays as it is on purpose: it is now DEFENCE IN DEPTH only,
// and its failure mode is to deny, which is safe. Loosening it to signedIn()
// (the avatar rule, which demonstrably works) would hand every signed-in
// account any attachment whose exact object path it learned, and buy nothing —
// no client reads Storage directly any more. Write rules are untouched: the
// browser still uploads straight to Storage, and `create` is what guards that.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // PHASE 16 (§X) — THE ALLOW LIST. This tracker is private: an account that
    // is not on the list may write nothing, here included. The list lives in
    // `_config/allow` (server-owned); every person carries the answer on their
    // own profile as `users/{uid}.allowed`, which is what this reads —
    // firestore.rules explains why ABSENT reads as allowed and only an
    // explicit `false` refuses.
    //
    // This is a CROSS-SERVICE lookup, whose failure mode is an error and so a
    // 403 (see the note at the top of this file). It therefore guards WRITES
    // only — the paths where refusing wrongly costs an upload, never a read —
    // and asks exists() first, so a profile that is not there yet is not a
    // refusal. Attachment uploads need a board ROLE, which an account that is
    // not allowed can never be given, so they are covered already.
    function notRefused(uid) {
      return !firestore.exists(/databases/(default)/documents/users/$(uid))
        || firestore.get(/databases/(default)/documents/users/$(uid)).data.get('allowed', true) != false;
    }

    function boardDoc(boardId) {
      return firestore.get(/databases/(default)/documents/boards/$(boardId)).data;
    }

    function canReadBoard(boardId) {
      return signedIn() && request.auth.uid in boardDoc(boardId).readerUids;
    }

    // Anyone who may put words on the board may attach a file to them:
    // admin and editor (descriptions, new tickets) and commenter (a comment
    // with a file — messagePost needs only can(comment)). Viewers read only.
    function canWriteBoard(boardId) {
      return signedIn()
        && boardDoc(boardId).access.get(request.auth.uid, null) in ['admin', 'editor', 'commenter'];
    }

    // boards/{boardId}/tickets/{ticketId}/{attachmentId}/{fileName}
    // (and the thumb_400.webp that onAttachmentFinalized writes beside it).
    //
    // RETIRED FOR NEW FILES (docs/plan/memory.html §J): a board takes no files
    // of its own — a file put on a ticket goes INTO a memory granted `write`
    // to the board (memories/… below, with metadata.boardId). Existing objects
    // stay readable; only the server writes here now (thumbnails).
    match /boards/{boardId}/tickets/{ticketId}/{attachmentId}/{fileName} {
      allow read: if canReadBoard(boardId);
      allow create, update, delete: if false;
    }

    // Profile picture: users/{uid}/avatar/{millis}.webp, 256px.
    match /users/{uid}/avatar/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && notRefused(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // An agent's picture (agents.html §B): users/{ownerUid}/agents/{agentId}/avatar/{millis}.webp.
    // Only the owner uploads under their own prefix — before or after the
    // profile exists (agentCreate takes a client-chosen agentId for this);
    // agentUpdate checks the path belongs to that agent. Shown on boards, so
    // any signed-in person may read it, like a person's avatar.
    match /users/{uid}/agents/{agentId}/avatar/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && notRefused(uid)
        && agentId.matches('ag_[A-Za-z0-9]{16}')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------ artifacts
    // (docs/plan/artifacts.html §E4, §G) — artifacts/{artifactId}/…
    //
    //   files/**            THE ARTIFACT'S OWN STORAGE (db.storage.upload). The
    //                       host page uploads as the viewer; whoever may write
    //                       the artifact's data may upload, 25 MB a file.
    //   uploads/{id}.zip    a build (or source) zip on its way to
    //                       artifactPublish: owner and editor only, written
    //                       once, swept after a day if never published.
    //   builds/**, source/**   written by the server only, and served only by
    //                       the /c route and signed links. No client access.
    //
    // NO CLIENT READ, LIST OR DELETE ANYWHERE UNDER artifacts/ — for the reason
    // at the top of this file: a read rule would need the cross-service
    // firestore.get(), whose failure is an error and so a 403. Reads, lists and
    // deletes are commands (artifactFileUrl / FileList / FileDelete) that check
    // the role themselves. For WRITES the lookup is acceptable: refusing
    // wrongly costs an upload the person can retry, never a read that breaks a
    // page.
    //
    // An artifact that does not exist makes the lookup an error, and an error
    // denies — so nothing can be uploaded under an id nobody created.

    function artifactDoc(artifactId) {
      return firestore.get(/databases/(default)/documents/artifacts/$(artifactId)).data;
    }

    // artifactCan.writeData (shared/src/artifacts/schema.ts), plus 'never when
    // archived' and the allow list — the same answer firestore.rules gives for
    // the artifact's documents.
    function artifactMayWrite(artifactId) {
      let art = artifactDoc(artifactId);
      let role = art.access.get(request.auth.uid, null);
      return signedIn()
        && notRefused(request.auth.uid)
        && art.archivedAt == null
        && (role == 'owner' || role == 'editor' || (role == 'viewer' && art.readOnly == false));
    }

    function artifactMayPublish(artifactId) {
      let art = artifactDoc(artifactId);
      return signedIn()
        && notRefused(request.auth.uid)
        && art.archivedAt == null
        && art.access.get(request.auth.uid, null) in ['owner', 'editor'];
    }

    match /artifacts/{artifactId}/files/{path=**} {
      // ARTIFACT_UPLOAD_MAX_BYTES. `update` too: an artifact may replace its
      // own file (a profile picture, a saved drawing).
      allow create, update: if artifactMayWrite(artifactId)
        && request.resource.size < 25 * 1024 * 1024;
      allow read, delete: if false;
    }

    match /artifacts/{artifactId}/uploads/{file} {
      // ARTIFACT_SOURCE_MAX_BYTES: the larger of the two zips that land here.
      // artifactPublish holds the BUILD zip to its own, smaller limit
      // (ARTIFACT_ZIP_MAX_BYTES) before it unpacks a byte.
      allow create: if resource == null
        && artifactMayPublish(artifactId)
        && file.matches('[A-Za-z0-9_-]{1,64}[.]zip')
        && request.resource.size < 50 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    match /artifacts/{artifactId}/builds/{path=**} {
      allow read, write: if false;
    }

    match /artifacts/{artifactId}/source/{path=**} {
      allow read, write: if false;
    }

    // memories/{memoryId}/{fileId}/{fileName} — one VERSION of a memory file
    // (docs/plan/memory.html §A, D-M2). The app uploads it straight here, then
    // memoryFilePut points a node at it. Written ONCE (a new version is a new
    // object), by the memory's owner or an editor, up to 1 GB
    // (MEMORY_UPLOAD_MAX_BYTES). A cross-service lookup, guarding a WRITE
    // only (see the top of this file). Reads, updates and deletes are the
    // server's: the file door for bytes, the commands for the rest.
    function memoryMayWrite(memoryId) {
      return signedIn()
        && notRefused(request.auth.uid)
        && firestore.get(/databases/(default)/documents/memories/$(memoryId)).data.access.get(request.auth.uid, null) in ['owner', 'editor']
        && firestore.get(/databases/(default)/documents/memories/$(memoryId)).data.archivedAt == null;
    }

    // §J — A TICKET ATTACHMENT goes into a memory granted `write` to the
    // board, by anyone who may put words on that board (admin, editor,
    // commenter: canWriteBoard), whatever their role on the memory. The upload
    // names the board in its metadata ({ boardId }); messagePost / ticketCreate
    // `memoryUploads` then make it a NEW node (never replacing one). An
    // archived or deleting memory takes nothing.
    function memoryTakesBoardFile(memoryId) {
      let boardId = request.resource.metadata.get('boardId', null);
      let m = firestore.get(/databases/(default)/documents/memories/$(memoryId)).data;
      return signedIn()
        && notRefused(request.auth.uid)
        && boardId is string
        && boardId.matches('[A-Za-z0-9_-]{1,64}')
        && m.boards.get(boardId, null) == 'write'
        && m.archivedAt == null
        && m.get('deletingAt', null) == null
        && canWriteBoard(boardId);
    }

    match /memories/{memoryId}/{fileId}/{fileName} {
      allow create: if resource == null
        && fileId.matches('[A-Za-z0-9_-]{6,64}')
        && request.resource.size <= 1024 * 1024 * 1024
        && (memoryMayWrite(memoryId) || memoryTakesBoardFile(memoryId));
      allow read, update, delete: if false;
    }

    // exports/{uid}/{jobId}.zip — written by accountExport, handed out as a
    // 7-day signed URL (which bypasses rules). No client access.
    match /exports/{uid}/{file} {
      allow read, write: if false;
    }
  }
}
