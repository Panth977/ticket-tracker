# Cloud Functions env for ONE Firebase project — NON-SECRET values only.
# Copy to backend/.env.<your-project-id> (gitignored). The Firebase CLI loads it at
# deploy (code analysis) and into every function; scripts/deploy-functions.mjs
# copies it into backend/deploy/ and inlines TM_REGION / TM_SECRETS / TM_WEB_API_KEY.
#
# Secrets (RESEND_API_KEY, WHATSAPP_TOKEN, TYPESENSE_API_KEY, GITHUB_WEBHOOK_SECRET …)
# never go here: `firebase functions:secrets:set NAME --project <your-project-id>`,
# then add NAME to TM_SECRETS below and redeploy. See docs/plan/run.html › Deploy.

# Region of every function, task queue and schedule (hosting rewrites follow it).
TM_REGION=asia-south1

# Links in mail / push / WhatsApp, OAuth and REST discovery documents.
APP_URL=https://<your-project-id>.web.app
API_URL=https://<your-project-id>.web.app

# The owner: allowed by definition, sees the Users module, adds everyone else
# to the allow list. The SPA gets the same address as PUBLIC_TM_ADMIN_EMAIL.
TM_ADMIN_EMAIL=you@example.com

# Secret Manager secrets to bind as env vars, comma-separated. Empty = none
# (every third-party channel stays off; see backend/src/adapters/notConfigured.ts).
TM_SECRETS=

# GET /v1/live exchanges a custom token for an ID token at the Identity Toolkit,
# which takes the project's web API key. Public by design (the SPA ships it as
# PUBLIC_FIREBASE_API_KEY); it names the project and grants nothing.
TM_WEB_API_KEY=

# Rate limiting is OFF by default (a private tracker); set to 1 to enable.
# TM_RATE_LIMITS=1
