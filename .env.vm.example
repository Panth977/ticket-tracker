# TaskManager on a VM (docker compose / docker run --env-file). Copy to .env.vm.
# Only APP_URL is required; everything else switches a feature on.

# Where people reach the app — links in mail and push point here.
APP_URL=https://tasks.example.com

# The account that may use the admin pages (optional).
TM_ADMIN_EMAIL=

# ── e-mail (sign-in links, invites, notifications) ── one of:
# SMTP_URL=smtps://user%40example.com:app-password@smtp.example.com:465
# SMTP_URL=smtp://user:password@smtp.example.com:587      (STARTTLS)
# RESEND_API_KEY=
EMAIL_FROM=TaskManager <tasks@example.com>

# ── sign in with Google / Microsoft (optional; e-mail links always work) ──
# Redirect URI to register: ${APP_URL}/identity/oauth/google.com/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Redirect URI: ${APP_URL}/identity/oauth/microsoft.com/callback
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common

# ── push notifications ── a VAPID key pair is made on first start and kept in
# /data; set these only to bring your own. TM_VAPID_SUBJECT defaults to
# mailto:${TM_ADMIN_EMAIL}.
# TM_VAPID_PUBLIC_KEY=
# TM_VAPID_PRIVATE_KEY=
# TM_VAPID_SUBJECT=mailto:you@example.com

# ── branding (optional) ── the name in the tab, the installed app and mails.
# TM_APP_NAME=Acme Tasks
# TM_APP_SHORT_NAME=Acme            (home-screen label; default: the name, or its first word)
# The logo: mount it at /branding/logo.png (or .svg / .webp / .jpg), e.g.
#   -v ./logo.png:/branding/logo.png:ro
# and every icon (favicon, PWA, Apple touch) is made from it at start.
# TM_LOGO=/somewhere/else/logo.png  (instead of /branding/logo.*)
# TM_LOGO_BG=#ffffff                (behind the logo where an icon must be opaque)

# ── artifacts on their own origin (optional) ── by default artifacts are served
# from APP_URL/c/… inside a sandbox (an opaque origin). Point a second host name
# at the same port to give them a separate origin as well.
# TM_ARTIFACT_ORIGIN=https://usercontent.example.com
