# Copy to workspaces/.env (gitignored, chmod 600).

# The app's origin (your deployment). Every orch and `ws new` talk to it.
TM_BASE=https://<your-project-id>.web.app

# An ACCOUNT token (Account › Tokens › Account token · preset Full account).
# Only `ws new` reads it, to create boards and agents. Optional otherwise.
TM_ACCOUNT_TOKEN=
