        "artifacts:read",
        "artifacts:write"
      ],
      "summary": "A short-lived URL for the newest source zip"
    },
    {
      "method": "PUT",
      "path": "/v1/artifacts/{id}/access",
      "scopes": [
        "artifacts:write"
      ],
