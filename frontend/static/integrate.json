  "artifacts": {
    "openUrl": "https://taskmanager-example.web.app/x/{id}",
    "roles": [
      "owner",
      "editor",
      "viewer"
    ],
    "scopes": [
      {
        "name": "artifacts:read",
        "label": "Read artifacts and download their source"
      },
      {
        "name": "artifacts:write",
        "label": "Create, publish and share artifacts"
      }
    ],
    "agentAccess": {
      "build": [
        true,
        false
      ],
      "data": [
        "none",
        "read",
        "write"
      ],
      "onCreate": {
        "build": true,
        "data": "write"
      }
    },
    "rest": [
      "GET /v1/artifacts",
      "POST /v1/artifacts",
      "GET /v1/artifacts/{id}",
      "PATCH /v1/artifacts/{id}",
      "DELETE /v1/artifacts/{id}",
      "POST /v1/artifacts/{id}/builds",
      "POST /v1/artifacts/{id}/builds/{build}/current",
      "GET /v1/artifacts/{id}/source",
      "PUT /v1/artifacts/{id}/access",
      "GET /v1/artifacts/{id}/data/firestore/{path}",
      "PUT /v1/artifacts/{id}/data/firestore/{path}",
      "PATCH /v1/artifacts/{id}/data/firestore/{path}",
      "DELETE /v1/artifacts/{id}/data/firestore/{path}",
      "POST /v1/artifacts/{id}/data/firestore/{path}",
      "POST /v1/artifacts/{id}/data/batch",
      "GET /v1/artifacts/{id}/data/rtdb/{path}",
      "PUT /v1/artifacts/{id}/data/rtdb/{path}",
      "PATCH /v1/artifacts/{id}/data/rtdb/{path}",
      "DELETE /v1/artifacts/{id}/data/rtdb/{path}",
      "POST /v1/artifacts/{id}/data/rtdb/{path}",
      "GET /v1/artifacts/{id}/data/files",
      "PUT /v1/artifacts/{id}/data/files/{path}",
      "GET /v1/artifacts/{id}/data/files/{path}",
      "DELETE /v1/artifacts/{id}/data/files/{path}"
    ],
    "mcpTools": [
      "artifact_list",
      "artifact_get",
      "artifact_create",
      "artifact_publish",
      "artifact_rollback",
      "artifact_share",
      "artifact_source",
      "artifact_data_get",
      "artifact_data_list",
      "artifact_data_set",
      "artifact_data_batch"
    ],
    "data": {
      "rest": [
        {
          "method": "GET",
          "path": "/v1/artifacts/{id}/data/firestore/{path}",
          "needs": "read",
          "summary": "Read a document, or list a collection, of the artifact's Firestore"
        },
        {
          "method": "PUT",
          "path": "/v1/artifacts/{id}/data/firestore/{path}",
          "needs": "write",
          "summary": "Set a document (?merge=1 merges)"
        },
        {
          "method": "PATCH",
          "path": "/v1/artifacts/{id}/data/firestore/{path}",
          "needs": "write",
          "summary": "Update fields of an existing document"
        },
        {
          "method": "DELETE",
          "path": "/v1/artifacts/{id}/data/firestore/{path}",
          "needs": "write",
          "summary": "Delete a document"
        },
        {
          "method": "POST",
          "path": "/v1/artifacts/{id}/data/firestore/{path}",
          "needs": "write",
          "summary": "Add a document to a collection"
        },
        {
          "method": "POST",
          "path": "/v1/artifacts/{id}/data/batch",
          "needs": "write",
          "summary": "Up to 400 Firestore writes, all or nothing"
        },
        {
          "method": "GET",
          "path": "/v1/artifacts/{id}/data/rtdb/{path}",
          "needs": "read",
          "summary": "Read a value of the artifact's Realtime Database"
        },
        {
          "method": "PUT",
          "path": "/v1/artifacts/{id}/data/rtdb/{path}",
          "needs": "write",
          "summary": "Set a value"
        },
        {
          "method": "PATCH",
          "path": "/v1/artifacts/{id}/data/rtdb/{path}",
          "needs": "write",
          "summary": "Update children of a value"
        },
        {
          "method": "DELETE",
          "path": "/v1/artifacts/{id}/data/rtdb/{path}",
          "needs": "write",
          "summary": "Remove a value"
        },
        {
          "method": "POST",
          "path": "/v1/artifacts/{id}/data/rtdb/{path}",
          "needs": "write",
          "summary": "Push a child with a generated key"
        },
        {
          "method": "GET",
          "path": "/v1/artifacts/{id}/data/files",
          "needs": "read",
          "summary": "List the artifact's files under a prefix"
        },
        {
          "method": "PUT",
          "path": "/v1/artifacts/{id}/data/files/{path}",
          "needs": "write",
          "summary": "Upload a file: the raw body is the file (≤ 25 MB)"
        },
        {
          "method": "GET",
          "path": "/v1/artifacts/{id}/data/files/{path}",
          "needs": "read",
          "summary": "A short-lived download URL for a file"
        },
        {
          "method": "DELETE",
          "path": "/v1/artifacts/{id}/data/files/{path}",
          "needs": "write",
          "summary": "Delete a file"
        }
      ],
      "mcpTools": [
        "artifact_data_get",
        "artifact_data_list",
        "artifact_data_set",
        "artifact_data_batch"
      ],
      "sdk": "tm.artifacts.data(id)",
      "escapes": {
        "date": {
          "$date": "<ISO 8601>"
        },
        "serverTime": {
          "$serverTime": true
        }
      },
      "whereOps": [
        "<",
        "<=",
        "==",
        "!=",
        ">=",
        ">",
        "array-contains",
        "in",
        "not-in",
        "array-contains-any"
      ],
      "limits": {
        "batchWrites": 400,
        "listDefault": 100,
        "listMax": 500,
        "whereFilters": 10,
        "uploadBytes": 26214400,
        "fileListMax": 1000,
        "pathChars": 1024
      }
    },
    "limits": {
      "buildBytes": 26214400,
      "buildFiles": 2000,
      "zipBytes": 27262976,
      "inlineBytes": 5242880,
      "sourceBytes": 52428800,
      "buildsKept": 10,
      "uploadBytes": 26214400,
      "listeners": 50
    },
    "reservedCollections": [
      "tickets",
      "reads"
    ]
  },
  "auth": {
    "scheme": "Bearer",
    "header": "Authorization: Bearer tm_live_…",
    "tokenPrefix": "tm_live_",
    "howToGetOne": "https://taskmanager-example.web.app/agents — a person makes an agent, puts it on boards and artifacts, and generates its ONE token on the agent's page. (https://taskmanager-example.web.app/account/tokens makes account tokens and board tokens that act as the person.)",
    "tokenKinds": [
      "board",
      "account",
      "agent"
    ],
    "agentToken": {
      "onePerAgent": true,
      "scopes": [
        "board:read",
        "members:read",
        "tickets:read",
        "tickets:create",
        "tickets:update",
        "tickets:move",
        "tickets:assign",
        "tickets:state",
        "comments:read",
        "comments:write",
        "files:read",
        "files:write",
        "questions:write",
        "tasklists:write",
        "status:write",
        "events:read",
        "board:admin",
        "webhooks:manage",
        "artifacts:read",
        "artifacts:write",
        "memory:read",
        "memory:write"
      ],
      "boardRoles": [
        "admin",
        "editor",
        "commenter",
        "viewer"
      ],
      "namesBoardWith": {
        "rest": "?board=KEY or /v1/boards/KEY/…",
        "mcp": "board",
        "sdk": "createClient({ token, board }) / tm.board('KEY')"
      },
      "defaultBoard": "GET /v1/me default_board — only on a token converted from an old board token"
    },
    "boardScoped": false,
    "idempotencyHeader": "Idempotency-Key"
  },
