    },
    {
      "name": "tickets:move",
      "label": "Move tickets between stages"
    },
    {
      "name": "tickets:assign",
      "label": "Assign and unassign tickets"
    },
    {
      "name": "tickets:state",
      "label": "Archive and restore tickets"
    },
    {
      "name": "comments:read",
