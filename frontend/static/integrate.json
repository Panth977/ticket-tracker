  "events": [
    {
      "type": "assigned",
      "means": "you were put on a ticket — the usual trigger to start work"
    },
    {
      "type": "unassigned",
      "means": "you were taken off it; stop"
    },
    {
      "type": "mentioned",
      "means": "a message names you (@your-agent-name)"
    },
    {
      "type": "comment",
      "means": "a new message on a ticket you are on"
    },
    {
      "type": "stage",
      "means": "the ticket moved to another stage"
    },
    {
      "type": "updated",
      "means": "title, fields, dates, tags or links changed"
    },
    {
      "type": "created",
      "means": "a ticket you watch was created"
    },
    {
      "type": "question_answered",
      "means": "somebody submitted the form you asked — `event.question.values` is here"
    },
    {
      "type": "question_cancelled",
      "means": "your question was cancelled or expired; stop waiting"
    }
  ],
  "notifyEvents": [
    "assigned",
    "mentioned",
    "comment",
    "stage",
    "updated",
    "created",
    "dueSoon",
    "overdue",
    "state",
    "invited",
    "question",
    "agentSilence"
  ],
  "errorCodes": [
    {
      "code": "invalid",
      "status": 400,
      "means": "the input failed validation, or names something not on the board"
    },
    {
      "code": "unauthenticated",
      "status": 401,
      "means": "no / bad / revoked / expired token — do not retry"
    },
    {
      "code": "forbidden",
      "status": 403,
      "means": "the role or the scope says no — do not retry"
    },
    {
      "code": "not_found",
      "status": 404,
      "means": "gone, or on a board you cannot read (existence is never leaked)"
    },
    {
      "code": "conflict",
      "status": 409,
      "means": "a state conflict: key taken, stale update, ticket not active"
    },
    {
      "code": "gone",
      "status": 410,
      "means": "it existed and is gone (an expired invite, a cancelled question)"
    },
    {
      "code": "too_large",
      "status": 413,
      "means": "over the body or attachment limit"
    },
    {
      "code": "unprocessable",
      "status": 422,
      "means": "well-formed, but a board rule refuses it (a stage’s `requires`)"
    },
    {
      "code": "rate_limited",
      "status": 429,
      "means": "back off — `Retry-After` says how long (the SDK does this for you)"
    },
    {
      "code": "internal",
      "status": 500,
      "means": "a bug on our side; retry with backoff"
    },
    {
      "code": "unavailable",
      "status": 503,
      "means": "a dependency is down; safe to retry"
    }
  ],
