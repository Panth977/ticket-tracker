      "readOnly": false,
      "scopes": [
        "files:write"
      ]
    },
    {
      "name": "read_file",
      "description": "Read a file: the text for Markdown, HTML, text, CSV, JSON and code; a short-lived download URL otherwise.",
      "readOnly": true,
      "scopes": [
        "files:read"
      ]
    },
    {
      "name": "link_tickets",
      "description": "Link two tickets: blocks, relates or duplicates.",
      "readOnly": false,
      "scopes": [
        "tickets:update"
      ]
    },
    {
      "name": "get_events",
