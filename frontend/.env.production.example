# Copy to frontend/.env.production (gitignored) — `pnpm deploy:prod` builds the SPA
# with it (vite build loads .env.production). Values: Firebase console › Project
# settings › Your apps › Web app › SDK setup and configuration.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=<your-project-id>
PUBLIC_FIREBASE_STORAGE_BUCKET=<your-project-id>.firebasestorage.app
# RTDB outside the US lives on *.firebasedatabase.app (e.g. asia-southeast1).
PUBLIC_FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.asia-southeast1.firebasedatabase.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Must be off for a real project (defaults to on only for demo-* projects).
PUBLIC_USE_EMULATORS=false

# The owner's address — the same value as TM_ADMIN_EMAIL in backend/.env.<project>.
# It only decides what the app SHOWS (the Users module); every refusal is the server's.
PUBLIC_TM_ADMIN_EMAIL=you@example.com

# Optional. Web push: Cloud Messaging › Web Push certificates › key pair.
PUBLIC_FCM_VAPID_KEY=
# Optional. true once the backend has WHATSAPP_TOKEN + WHATSAPP_PHONE_ID; unset greys WhatsApp out.
PUBLIC_WHATSAPP_ENABLED=
