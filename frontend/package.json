{
  "name": "@tm/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit 2 + Svelte 5 SPA (adapter-static), Tailwind v4, TipTap.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings=false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "mcp-ui:build": "vite build --config mcp-ui/vite.config.ts && node mcp-ui/emit.mjs",
    "mcp-ui:check": "svelte-check --workspace \"$PWD/mcp-ui\" --tsconfig \"$PWD/mcp-ui/tsconfig.json\"",
    "mcp-ui:dev": "vite --config mcp-ui/vite.config.ts --port 5180 --strictPort"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tm/shared": "workspace:*",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3",
    "fflate": "^0.8.2",
    "firebase": "^12.19.0",
    "highlight.js": "^11",
    "lucide-svelte": "^1.0.1",
    "markdown-it": "^14",
    "svelte-dnd-action": "^0.9.79",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/markdown-it": "^14",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
